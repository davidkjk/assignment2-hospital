# 백엔드 환경변수 목록 (값 없음 — 실제 값은 플랫폼 환경변수에만 저장, 이 파일에 실키 커밋 금지)
# 각 값을 어디서 얻는지: docs 납품문서(Task 20) 또는 Supabase/Railway 대시보드 참고.
# 아래는 backend/app/core/config.py의 Settings가 실제로 읽는 이름 그대로다(대문자 = 환경변수).

# ── Supabase ─────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
DATABASE_URL=   # ⚠️ C6-#9: RLS를 우회하는 DB 역할로 접속해야 한다(연결 소유자/BYPASSRLS).
                #   raw get_pool() 경로(디스패처·배치)가 이 전제 위에서만 동작한다 —
                #   authenticated로 접속하면 발송/부도/만료 배치가 조용히 RLS에 막힌다.
                #   (backend/app/db/pool.py 계약)

# ── 세션·비밀번호 복구 ─────────────────────────────────────
SESSION_TIMEOUT_MINUTES=30
STAFF_WEB_ORIGIN=   # 직원 비밀번호 재설정 링크가 되돌아올 서버 소유 origin(경로 없이 http(s)만).
                    #   비면 fail-closed: 중립 응답은 유지하되 링크를 보내지 않는다(auth_staff.py).

# ── AI 상담봇 (4단계) — 비우면 자동 테스트는 stub, 값 넣으면 실제 LLM/임베딩 ──
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
CHAT_MODEL=claude-sonnet-5
EMBEDDING_MODEL=text-embedding-3-small
ANON_RATE_LIMIT_PER_HOUR=30
ANON_CONTACT_ENCRYPTION_KEY=   # 익명 웹 상담 연락처(전화)의 Fernet base64 대칭키.
                               #   문자 폴백 때 dispatcher가 복호화(anonymous_contact_codec 지연 초기화).

# ── 백업 (Task 7 · 14일 보관) ──────────────────────────────
BACKUP_BUCKET=backups

# ── CORS (Task 14에서 CORSMiddleware가 소비) ───────────────
# 콤마구분 문자열 — 직원 웹·webchat Vercel 도메인. 환자 앱은 모바일이라 불필요.
ALLOWED_ORIGINS=https://<직원웹>.vercel.app,https://<webchat>.vercel.app

# ── 문자 발송 제공자 (배포 시 주입) ────────────────────────
# 전화 OTP = Supabase Send SMS Hook 엣지함수가 SOLAPI로 발송(supabase/functions/send-sms-hook).
#   아래 4개는 backend .env가 아니라 Supabase 대시보드의 Edge Function secrets에 넣는다:
#     SOLAPI_API_KEY / SOLAPI_API_SECRET / SOLAPI_SENDER_NUMBER / SEND_SMS_HOOK_SECRET
#   (SEND_SMS_HOOK_SECRET = 대시보드 Send SMS Hook의 v1,whsec_ 원문. SOLAPI 키는 IP제한 끌 것.)
# 알림 문자/푸시 outbound(리마인더·부도 등)는 dispatch_service의 주입 경계(sms_send·push_send)로,
#   실제 제공자 연결은 배포 단계(7C) 몫이다. 그때 필요해지는 이름(현재 코드 미소비):
#     TWILIO_ACCOUNT_SID / TWILIO_AUTH_TOKEN / TWILIO_FROM_NUMBER / FCM_SERVICE_ACCOUNT_JSON
