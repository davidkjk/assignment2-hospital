# 작업용 문서 — 설계 논의·검토 기록, 배포 산출물이 아니라 git 추적 제외
CLAUDE.md

# Supabase CLI 로컬 실행 시 생성되는 임시 상태 디렉토리
supabase/.temp/
supabase/.branches/

# 로컬 도구 설정 — 팀/환경마다 다를 수 있어 추적 제외
.claude/

# 비주얼 컴패니언(브레인스토밍 목업) 세션 파일
.superpowers/

# macOS 파인더가 만드는 폴더 정보 파일
.DS_Store

# 파이썬 캐시 — 검사기(spec-index/*.py)를 돌릴 때마다 생긴다
__pycache__/
*.pyc

# 로컬 개발용 환경변수 — 기기마다 다르고 키가 들어간다
.env.local

# 화면 대조 shot 출력(PNG) · 스크래치
tools/shot/shot/
output/
tmp/

# 비밀 자격증명(Firebase 서비스 계정 키, 각종 서비스 키 파일) — 절대 커밋 금지.
# ⚠️ git 히스토리에 한 번이라도 올라가면 영구히 남으므로, 실수로 커밋했으면 파일 삭제로 끝내지 말고
#    해당 서비스에서 키를 재발급(rotate)한다.
secrets/*
!secrets/README.md
*serviceAccount*.json
*service-account*.json
*-adminsdk-*.json
.env
