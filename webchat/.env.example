# 상담봇 webchat 환경변수 (lib/env.ts가 읽는 값)
#
# Supabase(익명/로그인 인증용) — Project Settings > API 에서 얻는다.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
#
# 상담봇 백엔드(FastAPI `/chat/*`) 주소. 보통은 비워둔다.
# 비우면 상대경로로 부르고, 배포는 vercel.json rewrite가·로컬은 vite proxy가 Railway/:8000으로 넘긴다(same-origin).
# 프록시 없이 다른 도메인 백엔드를 직접 부를 때만 값을 채운다(그 경우 백엔드 CORS 허용목록 필요).
VITE_API_BASE_URL=
